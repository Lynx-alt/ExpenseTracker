@page "/register"
@layout AuthLayout
@using ExpenseTracker.Client.Services
@using ExpenseTracker.Shared.DTOs
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registrati · ExpenseTracker</PageTitle>

<div class="auth-card">
    <h1 class="serif auth-title">Crea un account</h1>
    <p class="auth-intro">Bastano pochi secondi per iniziare a tenere traccia delle tue spese.</p>

    <EditForm Model="registerDto" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error" role="alert">@errorMessage</div>
        }

        <div class="auth-field">
            <label class="field-label" for="reg-username">Nome utente</label>
            <InputText id="reg-username" autocomplete="username"
                       @bind-Value="registerDto.Username" class="form-control" />
            <ValidationMessage For="() => registerDto.Username" />
        </div>

        <div class="auth-field">
            <label class="field-label" for="reg-email">Email</label>
            <InputText id="reg-email" type="email" autocomplete="email" placeholder="nome@esempio.it"
                       @bind-Value="registerDto.Email" class="form-control" />
            <ValidationMessage For="() => registerDto.Email" />
        </div>

        <div class="auth-field">
            <label class="field-label" for="reg-password">Password</label>
            <InputText id="reg-password" type="password" autocomplete="new-password"
                       @bind-Value="registerDto.Password" class="form-control" />
            <div class="auth-hint">Almeno 8 caratteri.</div>
            <ValidationMessage For="() => registerDto.Password" />
        </div>

        <button type="submit" class="btn-accent auth-submit" disabled="@isSubmitting">
            @(isSubmitting ? "Creazione account..." : "Crea account")
        </button>
    </EditForm>

    <p class="auth-switch">Hai già un account? <a href="login">Accedi</a></p>
</div>

@code {
    private RegisterDto registerDto = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleRegister()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            if (await AuthService.RegisterAsync(registerDto))
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Registrazione non riuscita. L'email potrebbe essere già in uso.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Server non raggiungibile. Riprova tra poco.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}