@page "/login"
@layout AuthLayout
@using ExpenseTracker.Client.Services
@using ExpenseTracker.Shared.DTOs
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Accedi · ExpenseTracker</PageTitle>

<div class="auth-card">
    <h1 class="serif auth-title">Accedi</h1>
    <p class="auth-intro">Inserisci le tue credenziali per continuare.</p>

    <EditForm Model="loginDto" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error" role="alert">@errorMessage</div>
        }

        <div class="auth-field">
            <label class="field-label" for="login-email">Email</label>
            <InputText id="login-email" type="email" autocomplete="email" placeholder="nome@esempio.it"
                       @bind-Value="loginDto.Email" class="form-control" />
            <ValidationMessage For="() => loginDto.Email" />
        </div>

        <div class="auth-field">
            <label class="field-label" for="login-password">Password</label>
            <InputText id="login-password" type="password" autocomplete="current-password"
                       @bind-Value="loginDto.Password" class="form-control" />
            <ValidationMessage For="() => loginDto.Password" />
        </div>

        <button type="submit" class="btn-accent auth-submit" disabled="@isSubmitting">
            @(isSubmitting ? "Accesso in corso..." : "Accedi")
        </button>
    </EditForm>

    <p class="auth-switch">Non hai un account? <a href="register">Registrati</a></p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private LoginDto loginDto = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            if (await AuthService.LoginAsync(loginDto))
            {
                Navigation.NavigateTo(SafeReturnUrl());
            }
            else
            {
                errorMessage = "Email o password non corretti.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Server non raggiungibile. Riprova tra poco.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Accetta solo percorsi interni all'app, mai indirizzi esterni
    private string SafeReturnUrl() =>
        string.IsNullOrEmpty(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//")
            ? "/"
            : ReturnUrl;
}