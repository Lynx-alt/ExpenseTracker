@page "/"
@attribute [Authorize]
@using System.Globalization
@using ExpenseTracker.Client.Services
@using ExpenseTracker.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@inject ExpenseService ExpenseService
@inject CategoryService CategoryService

<PageTitle>Dashboard · ExpenseTracker</PageTitle>

<div class="page-header">
    <div>
        <div class="month-nav">
            <button class="month-nav-btn" aria-label="Mese precedente" @onclick="() => ChangeMonth(-1)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            </button>
            <span class="page-subtitle">@Capitalize(selectedMonth.ToString("MMMM yyyy"))</span>
            <button class="month-nav-btn" aria-label="Mese successivo" disabled="@IsCurrentMonth" @onclick="() => ChangeMonth(1)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </button>
        </div>
        <h1 class="serif page-title">Dashboard</h1>
    </div>
    <div class="header-actions">
        <button class="btn-soft" @onclick="() => showCategoriesModal = true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><circle cx="7" cy="7" r="1.5"></circle></svg>
            Categorie
        </button>
        <button class="btn-accent" @onclick="OpenExpenseModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
            Aggiungi spesa
        </button>
    </div>
</div>

@if (isLoading)
{
    <p class="muted">Caricamento...</p>
}
else
{
    <div class="stats-grid">
        <div class="card">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div class="stat-label">@(IsCurrentMonth ? "Speso questo mese" : "Speso nel mese")</div>
                <span class="pill" style="@DeltaStyle">@DeltaText</span>
            </div>
            <div class="hero-value num">@currentMonthTotal.ToString("C")</div>
            <div class="hero-sub">
                @(currentMonthCount == 1 ? "1 spesa" : $"{currentMonthCount} spese")
                in @(currentMonthCategoryCount == 1 ? "1 categoria" : $"{currentMonthCategoryCount} categorie")
            </div>
        </div>
        <div class="card">
            <div class="stat-label">@Capitalize(selectedMonth.AddMonths(-1).ToString("MMMM"))</div>
            <div class="stat-value num">@((comparison?.PreviousMonthTotal ?? 0).ToString("C"))</div>
        </div>
        <div class="card">
            <div class="stat-label">Spesa media</div>
            <div class="stat-value num">@averageExpense.ToString("C")</div>
        </div>
    </div>

    <div class="two-col">
        <div class="card">
            <div class="card-title">Spese per categoria</div>
            @if (donutSegments.Count == 0)
            {
                <p class="muted" style="margin: 0;">Nessuna spesa in questo mese.</p>
            }
            else
            {
                var hovered = HoveredSegment;
                <div class="donut-wrap">
                    <div class="donut">
                        <svg viewBox="0 0 180 180" role="img" aria-label="Ripartizione delle spese per categoria">
                            <circle class="donut-track" cx="90" cy="90" r="@DonutRadius"></circle>
                            @foreach (var s in donutSegments)
                            {
                                <circle class="donut-seg @(IsDimmed(s.CategoryId) ? "dim" : "")"
                                        cx="90" cy="90" r="@DonutRadius"
                                        stroke="@s.Color"
                                        stroke-dasharray="@Css(s.Dash) @Css(DonutCircumference - s.Dash)"
                                        stroke-dashoffset="@Css(-s.Offset)"
                                        @onmouseenter="() => hoveredCategoryId = s.CategoryId"
                                        @onmouseleave="() => hoveredCategoryId = null"></circle>
                            }
                        </svg>
                        <div class="donut-center">
                            <span class="donut-center-label">@(hovered?.Name ?? "Totale")</span>
                            <span class="donut-center-value serif num">@((hovered?.Amount ?? categoryTotal).ToString("C"))</span>
                            <span class="donut-center-sub">@DonutCenterSub</span>
                        </div>
                    </div>

                    <ul class="donut-legend">
                        @foreach (var s in donutSegments)
                        {
                            <li class="legend-row @(IsDimmed(s.CategoryId) ? "dim" : "")"
                                @onmouseenter="() => hoveredCategoryId = s.CategoryId"
                                @onmouseleave="() => hoveredCategoryId = null">
                                <span class="cat-icon" style="background: @ColorFor(s.CategoryId).PillBg; box-shadow: inset 0 0 0 2px @s.Color;" aria-hidden="true">@IconFor(s.Name)</span>
                                <span class="legend-name">@s.Name</span>
                                <span class="legend-amount num">@s.Amount.ToString("C")</span>
                                <span class="legend-share muted num">@s.Share.ToString("0")%</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-title">Ultimi 6 mesi</div>
            <div class="month-chart">
                @foreach (var m in lastSixMonths)
                {
                    <div class="month-col" tabindex="0" role="img"
                         aria-label="@m.FullLabel: @(m.Total > 0 ? m.Total.ToString("C") : "nessuna spesa")">
                        <span class="month-value num">@(m.IsSelected && m.Total > 0 ? m.Total.ToString("C0") : "")</span>
                        <div class="month-bar-area">
                            <div class="month-tip" style="bottom: calc(@Css(m.HeightPercent)% + 8px);">
                                <span class="month-tip-label">@m.FullLabel</span>
                                <span class="month-tip-value num">@(m.Total > 0 ? m.Total.ToString("C") : "Nessuna spesa")</span>
                            </div>
                            <div class="month-bar @(m.IsSelected ? "current" : m.Total > 0 ? "has-value" : "")"
                                 style="height: @Css(m.HeightPercent)%;"></div>
                        </div>
                        <span class="month-label @(m.IsSelected ? "current" : "")">@m.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card" style="padding: 8px;">
        @if (monthExpenses.Count == 0)
        {
            <div class="empty-state">
                <div class="serif" style="font-size: 24px; color: var(--text);">Nessuna spesa in questo mese</div>
                <p>Aggiungi una spesa per vedere qui il riepilogo.</p>
                <button class="btn-accent" @onclick="OpenExpenseModal">Aggiungi spesa</button>
            </div>
        }
        else
        {
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Descrizione</th>
                        <th>Categoria</th>
                        <th>Data</th>
                        <th class="col-amount">Importo</th>
                        <th style="width: 44px;"><span class="visually-hidden">Azioni</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in monthExpenses.OrderByDescending(e => e.Date).ThenByDescending(e => e.Id))
                    {
                        var color = ColorFor(expense.CategoryId);
                        <tr>
                            <td>
                                <div class="expense-desc">
                                    <span class="cat-icon" style="background: @color.PillBg;" aria-hidden="true">@IconFor(expense.CategoryName)</span>
                                    @expense.Description
                                </div>
                            </td>
                            <td><span class="pill" style="background: @color.PillBg; color: @color.PillText;">@expense.CategoryName</span></td>
                            <td class="muted">@expense.Date.ToString("d MMM")</td>
                            <td class="col-amount num">@expense.Amount.ToString("C")</td>
                            <td style="text-align: right;">
                                <button class="row-delete" aria-label="Elimina @expense.Description" @onclick="() => pendingDelete = expense">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0-1 14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6"></path></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (showExpenseModal)
{
    <div class="modal-overlay" @onclick="CloseExpenseModal">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="expense-modal-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 id="expense-modal-title" class="serif modal-title">Nuova spesa</h2>
                <button class="modal-close" aria-label="Chiudi" @onclick="CloseExpenseModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
                </button>
            </div>

            <EditForm Model="newExpense" OnValidSubmit="HandleCreateExpense">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label class="field-label" for="exp-amount">Importo (€)</label>
                        <InputNumber id="exp-amount" @bind-Value="newExpense.Amount" class="form-control field-amount" />
                    </div>
                    <div>
                        <label class="field-label" for="exp-desc">Descrizione</label>
                        <InputText id="exp-desc" @bind-Value="newExpense.Description" class="form-control" placeholder="Es. Pranzo con colleghi" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <label class="field-label" for="exp-date">Data</label>
                            <InputDate id="exp-date" @bind-Value="newExpense.Date" class="form-control" />
                        </div>
                        <div>
                            <label class="field-label" for="exp-cat">Categoria</label>
                            <InputSelect id="exp-cat" @bind-Value="newExpense.CategoryId" class="form-select">
                                <option value="0">Scegli...</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@IconFor(c.Name) @c.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <p class="form-error">@formError</p>
                    }
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-soft" style="flex: 1; justify-content: center;" @onclick="CloseExpenseModal">Annulla</button>
                    <button type="submit" class="btn-accent" style="flex: 2; justify-content: center;">Salva spesa</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showCategoriesModal)
{
    <div class="modal-overlay" @onclick="() => showCategoriesModal = false">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="cat-modal-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 id="cat-modal-title" class="serif modal-title">Categorie</h2>
                <button class="modal-close" aria-label="Chiudi" @onclick="() => showCategoriesModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
                </button>
            </div>

            <EditForm Model="newCategory" OnValidSubmit="HandleCreateCategory">
                <div style="display: flex; gap: 8px; margin-bottom: 16px;">
                    <InputText @bind-Value="newCategory.Name" class="form-control" placeholder="Nuova categoria" aria-label="Nome nuova categoria" />
                    <button type="submit" class="btn-accent" style="height: 44px;">Aggiungi</button>
                </div>
            </EditForm>

            <ul class="cat-list">
                @foreach (var c in categories)
                {
                    <li><span class="cat-icon" style="background: @ColorFor(c.Id).PillBg;" aria-hidden="true">@IconFor(c.Name)</span>@c.Name</li>
                }
            </ul>
        </div>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="modal-overlay" @onclick="() => pendingDelete = null">
        <div class="modal-card" role="alertdialog" aria-modal="true" aria-labelledby="del-title" style="width: 380px;" @onclick:stopPropagation="true">
            <h2 id="del-title" class="serif modal-title" style="font-size: 26px;">Eliminare la spesa?</h2>
            <p class="muted" style="margin: 12px 0 0;">
                «@pendingDelete.Description» da @pendingDelete.Amount.ToString("C") verrà eliminata definitivamente.
            </p>
            <div class="modal-actions">
                <button class="btn-soft" style="flex: 1; justify-content: center;" @onclick="() => pendingDelete = null">Annulla</button>
                <button class="btn-danger" style="flex: 1; justify-content: center;" @onclick="ConfirmDelete">Elimina</button>
            </div>
        </div>
    </div>
}

@if (toastMessage is not null)
{
    <div class="toast-msg" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8FAE8B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
        @toastMessage
    </div>
}

@code {
    private record MonthBar(string Label, string FullLabel, decimal Total, decimal HeightPercent, bool IsSelected);

    // Spicchio della ciambella: Dash = lunghezza visibile, Offset = punto di partenza sulla circonferenza
    private record DonutSegment(int CategoryId, string Name, decimal Amount, decimal Share, string Color, double Dash, double Offset);

    // Il raggio deve coincidere con il viewBox 180x180 usato nel markup (centro 90,90)
    private const int DonutRadius = 70;
    private static readonly double DonutCircumference = 2 * Math.PI * DonutRadius;

    // Tinte pastello per le categorie: (pallino/barra, sfondo pillola, testo pillola)
    private static readonly (string Dot, string PillBg, string PillText)[] Palette =
    {
        ("#8FAE8B", "#E3EDE1", "#56724F"),
        ("#E8A48C", "#FBE3DA", "#A35A45"),
        ("#C9A86A", "#F4EAD3", "#80672E"),
        ("#A99BC9", "#ECE7F5", "#5F5288"),
        ("#8FB3C4", "#E1EDF2", "#4A6E7E"),
        ("#D69AA8", "#F7E4E8", "#8E4E5D"),
    };

    // Parole chiave (parziali) del nome categoria → emoji. Vince la prima corrispondenza.
    private static readonly (string[] Keywords, string Icon)[] CategoryIcons =
    {
        (new[] { "trasport", "benzin", "carburant", "autostrad", "treno", "taxi" }, "🚗"),
        (new[] { "ristorant", "pranz", "cena", "caff", "pizz" }, "🍽️"),
        (new[] { "supermerc", "aliment" }, "🛒"),
        (new[] { "casa", "affitt", "bollett", "utenz", "mutuo" }, "🏠"),
        (new[] { "salute", "farmac", "medic", "dentist" }, "💊"),
        (new[] { "svago", "intratten", "cinema", "tempo libero", "giochi" }, "🎬"),
        (new[] { "viagg", "vacanz" }, "✈️"),
        (new[] { "shopping", "abbigliament", "vestit" }, "🛍️"),
        (new[] { "istruzion", "scuola", "libri", "formazion" }, "📚"),
        (new[] { "sport", "palestra" }, "💪"),
        (new[] { "abbonament", "streaming" }, "📺"),
        (new[] { "regal" }, "🎁"),
        (new[] { "animal" }, "🐾"),
    };

    private List<ExpenseDto> expenses = new();
    private List<ExpenseDto> monthExpenses = new();
    private List<CategoryDto> categories = new();
    private List<CategorySummaryDto> categorySummary = new();
    private List<DonutSegment> donutSegments = new();
    private List<MonthBar> lastSixMonths = new();
    private MonthComparisonDto? comparison;

    private CreateExpenseDto newExpense = new() { Date = DateTime.Today };
    private CreateCategoryDto newCategory = new();
    private ExpenseDto? pendingDelete;
    private string? formError;
    private string? toastMessage;

    private DateTime selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int? hoveredCategoryId;

    private bool isLoading = true;
    private bool showExpenseModal;
    private bool showCategoriesModal;

    private decimal currentMonthTotal;
    private decimal categoryTotal;
    private int currentMonthCount;
    private int currentMonthCategoryCount;
    private decimal averageExpense;

    private bool IsCurrentMonth =>
        selectedMonth.Year == DateTime.Today.Year && selectedMonth.Month == DateTime.Today.Month;

    private DonutSegment? HoveredSegment =>
        hoveredCategoryId is int id ? donutSegments.FirstOrDefault(s => s.CategoryId == id) : null;

    private string DonutCenterSub => HoveredSegment is { } h
        ? $"{h.Share:0}% del totale"
        : donutSegments.Count == 1 ? "1 categoria" : $"{donutSegments.Count} categorie";

    private bool IsDimmed(int categoryId) =>
        hoveredCategoryId is not null && hoveredCategoryId != categoryId;

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task ChangeMonth(int delta)
    {
        selectedMonth = selectedMonth.AddMonths(delta);
        await LoadAll();
    }

    private async Task LoadAll()
    {
        categories = await CategoryService.GetCategoriesAsync();
        expenses = await ExpenseService.GetExpensesAsync();
        categorySummary = await ExpenseService.GetSummaryByCategoryAsync(selectedMonth.Year, selectedMonth.Month);
        var monthly = await ExpenseService.GetSummaryByMonthAsync();
        comparison = await ExpenseService.GetMonthComparisonAsync(selectedMonth.Year, selectedMonth.Month);

        monthExpenses = expenses
            .Where(e => e.Date.Year == selectedMonth.Year && e.Date.Month == selectedMonth.Month)
            .ToList();
        currentMonthTotal = comparison?.CurrentMonthTotal ?? monthExpenses.Sum(e => e.Amount);
        currentMonthCount = monthExpenses.Count;
        currentMonthCategoryCount = monthExpenses.Select(e => e.CategoryId).Distinct().Count();
        averageExpense = currentMonthCount > 0 ? currentMonthTotal / currentMonthCount : 0;

        donutSegments = BuildDonut(categorySummary);
        categoryTotal = donutSegments.Sum(s => s.Amount);
        hoveredCategoryId = null;

        lastSixMonths = BuildLastSixMonths(monthly, selectedMonth);
        isLoading = false;
    }

    // Trasforma il riepilogo per categoria in spicchi: ogni spicchio è un cerchio SVG
    // con stroke-dasharray (quanto è lungo) e stroke-dashoffset (dove parte)
    private static List<DonutSegment> BuildDonut(List<CategorySummaryDto> summary)
    {
        var total = summary.Sum(c => c.TotalAmount);
        if (total <= 0) return new();

        var ordered = summary.OrderByDescending(c => c.TotalAmount).ToList();
        var gap = ordered.Count > 1 ? 3.0 : 0.0; // piccolo spazio tra uno spicchio e l'altro
        var offset = 0.0;
        var result = new List<DonutSegment>();

        foreach (var item in ordered)
        {
            var fraction = (double)(item.TotalAmount / total);
            var length = fraction * DonutCircumference;

            result.Add(new DonutSegment(
                item.CategoryId,
                item.CategoryName,
                item.TotalAmount,
                item.TotalAmount / total * 100,
                ColorFor(item.CategoryId).Dot,
                Math.Max(length - gap, 0.5),
                offset));

            offset += length;
        }

        return result;
    }

    // Costruisce sempre 6 colonne che finiscono nel mese selezionato, anche per i mesi senza spese (a zero)
    private static List<MonthBar> BuildLastSixMonths(List<MonthlySummaryDto> monthly, DateTime reference)
    {
        var months = Enumerable.Range(0, 6)
            .Select(i => reference.AddMonths(i - 5))
            .Select(d => (Date: d, Total: monthly.FirstOrDefault(m => m.Year == d.Year && m.Month == d.Month)?.TotalAmount ?? 0))
            .ToList();

        var max = months.Max(m => m.Total);

        return months.Select(m => new MonthBar(
            Capitalize(m.Date.ToString("MMM").TrimEnd('.')),
            Capitalize(m.Date.ToString("MMMM yyyy")),
            m.Total,
            max > 0 ? m.Total / max * 100 : 0,
            m.Date.Year == reference.Year && m.Date.Month == reference.Month)).ToList();
    }

    private string DeltaText => comparison?.PercentageChange is decimal p
        ? $"{(p > 0 ? "+" : "")}{p:0.#}% vs mese precedente"
        : "Nessun confronto";

    private string DeltaStyle => comparison?.PercentageChange is decimal p
        ? (p > 0 ? "background: #FBE3DA; color: #A35A45;" : "background: #E3EDE1; color: #56724F;")
        : "";

    private void OpenExpenseModal()
    {
        newExpense = new() { Date = DateTime.Today };
        formError = null;
        showExpenseModal = true;
    }

    private void CloseExpenseModal() => showExpenseModal = false;

    private async Task HandleCreateExpense()
    {
        if (newExpense.Amount <= 0) { formError = "L'importo deve essere maggiore di zero."; return; }
        if (newExpense.CategoryId == 0) { formError = "Scegli una categoria."; return; }

        if (await ExpenseService.CreateExpenseAsync(newExpense))
        {
            showExpenseModal = false;
            await LoadAll();
            _ = ShowToast("Spesa aggiunta");
        }
        else
        {
            formError = "Non è stato possibile salvare la spesa. Riprova.";
        }
    }

    private async Task HandleCreateCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategory.Name)) return;

        if (await CategoryService.CreateCategoryAsync(newCategory))
        {
            newCategory = new();
            await LoadAll();
            _ = ShowToast("Categoria aggiunta");
        }
    }

    private async Task ConfirmDelete()
    {
        if (pendingDelete is null) return;

        var id = pendingDelete.Id;
        pendingDelete = null;

        if (await ExpenseService.DeleteExpenseAsync(id))
        {
            await LoadAll();
            _ = ShowToast("Spesa eliminata");
        }
    }

    private async Task ShowToast(string message)
    {
        toastMessage = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);
        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private static (string Dot, string PillBg, string PillText) ColorFor(int categoryId) =>
        Palette[Math.Abs(categoryId) % Palette.Length];

    private static string IconFor(string? categoryName)
    {
        if (!string.IsNullOrWhiteSpace(categoryName))
        {
            foreach (var (keywords, icon) in CategoryIcons)
            {
                if (keywords.Any(k => categoryName.Contains(k, StringComparison.OrdinalIgnoreCase)))
                    return icon;
            }
        }
        return "🏷️";
    }

    // Numeri dentro il CSS/SVG: sempre col punto, mai con la virgola italiana
    private static string Css(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Css(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Capitalize(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
