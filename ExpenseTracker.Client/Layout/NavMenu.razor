@using ExpenseTracker.Client.Services
@using Microsoft.AspNetCore.Components.Authorization

<nav class="sidebar" aria-label="Navigazione principale">
    <div class="sidebar-brand">ExpenseTracker</div>

    <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
        Dashboard
    </NavLink>

    <div style="flex-grow: 1;"></div>

    <AuthorizeView>
        <Authorized>
            <div class="user-block">
                <div class="user-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</div>
                <div>
                    <div class="user-name">@context.User.Identity?.Name</div>
                    <button class="user-logout" @onclick="Logout">Esci</button>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <NavLink class="sidebar-link" href="login">Accedi</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private static string Initial(string? name) =>
        string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpper();
}